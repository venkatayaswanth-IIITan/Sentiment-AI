# ==============================================
# BrandPulse AI - Environment Configuration
# ==============================================

# Application Environment
NODE_ENV=development
PORT=5000

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_ML_URL=http://localhost:8000

# Backend & Database Configuration
DATABASE_URL=postgresql://brandpulse_user:brandpulse_secret@localhost:5432/brandpulse_db?schema=public
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Machine Learning Service Configuration
ML_SERVICE_URL=http://localhost:8000
ML_MODEL_TYPE=bilstm  # options: ml, cnn, bilstm
ML_MODEL_ARTIFACTS_DIR=./artifacts

# PostgreSQL Database (Docker)
POSTGRES_USER=brandpulse_user
POSTGRES_PASSWORD=brandpulse_secret
POSTGRES_DB=brandpulse_db
POSTGRES_PORT=5432
